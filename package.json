{
  "name": "paws-and-potjie",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently -k \"vite --host 0.0.0.0\" \"tsx watch server/index.ts\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "tsx watch server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p server/tsconfig.json",
    "validate:manual": "node scripts/manual-validate.mjs",
    "build": "npm run validate:manual && npm run typecheck && vite build && npm run poc:verify",
    "preview": "vite preview --host 0.0.0.0",
    "start": "tsx server/index.ts",
    "poc:verify": "node scripts/verify-poc.mjs"
  },
  "dependencies": {
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.6.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "framer-motion": "^12.40.0",
    "mongoose": "^9.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "0.185.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "0.185.0",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "7.0.2",
    "vite": "^8.1.5"
  },
  "kpgs": {
    "threeSource": {
      "fork": "RobynAwesome/three.js",
      "ref": "d2ac59a15620ff8696dd55983c1f411c0a3f92ce",
      "version": "0.185.0",
      "runtime": "three@0.185.0"
    }
  }
}
